package com.xx.jaseatschoicejava.agent.config;

import com.xx.jaseatschoicejava.agent.agents.*;
import com.xx.jaseatschoicejava.agent.tools.*;
import com.xx.jaseatschoicejava.agent.tools.merchant.MerchantQueryTools;
import com.xx.jaseatschoicejava.agent.tools.merchant.MerchantStatsTools;
import com.xx.jaseatschoicejava.agent.tools.nutrition.NutritionAnalysisTools;
import com.xx.jaseatschoicejava.agent.tools.nutrition.CalorieCalculatorTools;
import com.xx.jaseatschoicejava.agent.tools.order.OrderCreateTools;
import com.xx.jaseatschoicejava.agent.tools.order.OrderQueryTools;
import com.xx.jaseatschoicejava.agent.tools.recommendation.RecommendationFilterTools;
import com.xx.jaseatschoicejava.agent.tools.recommendation.RecommendationQueryTools;
import com.xx.jaseatschoicejava.agent.tools.recommendation.RecommendationRankTools;
import com.xx.jaseatschoicejava.agent.tools.system.LocationTools;
import com.xx.jaseatschoicejava.agent.tools.system.TimeTools;
import com.xx.jaseatschoicejava.agent.tools.user.UserProfileTools;
import com.xx.jaseatschoicejava.config.ZhipuAIConfig;
import dev.langchain4j.service.AiServices;
import dev.langchain4j.model.chat.ChatModel;
import dev.langchain4j.memory.ChatMemory;
import dev.langchain4j.memory.chat.MessageWindowChatMemory;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.boot.context.properties.EnableConfigurationProperties;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

import jakarta.annotation.Resource;

/**
 * Agent层级工作流配置类
 *
 * 实现真正的 L3→L2→L1 Agent 层级调用架构：
 * - L1 基础Agent：只调用工具，不调用其他Agent
 * - L2 领域Agent：调用L1 Agent处理复杂任务
 * - L3 编排Agent：调用L2和L1 Agent进行智能路由
 *
 * 实现原理：
 * LangChain4j 的 AiServices 支持将 Agent 作为工具注入。
 * 这样就可以实现 Agent 调用 Agent 的效果。
 *
 * @author Claude
 * @since 2026-03-25
 */
@Configuration
@EnableConfigurationProperties(ZhipuAIConfig.class)
public class AgenticWorkflowConfig {

    private static final Logger log = LoggerFactory.getLogger(AgenticWorkflowConfig.class);

    @Resource
    private ZhipuAIConfig zhipuAIConfig;

    // ==================== 工具类注入 ====================

    @Resource
    private UserProfileTools userProfileTools;

    @Resource
    private NutritionAnalysisTools nutritionAnalysisTools;

    @Resource
    private CalorieCalculatorTools calorieCalculatorTools;

    @Resource
    private RecommendationQueryTools recommendationQueryTools;

    @Resource
    private RecommendationFilterTools recommendationFilterTools;

    @Resource
    private RecommendationRankTools recommendationRankTools;

    @Resource
    private MerchantQueryTools merchantQueryTools;

    @Resource
    private MerchantStatsTools merchantStatsTools;

    @Resource
    private TimeTools timeTools;

    @Resource
    private LocationTools locationTools;

    @Resource
    private OrderQueryTools orderQueryTools;

    @Resource
    private OrderCreateTools orderCreateTools;

    // ==================== 模型和内存配置 ====================

    /**
     * 配置ChatModel
     */
    @Bean(destroyMethod = "")
    public ChatModel workflowChatModel() {
        log.info("初始化Agentic工作流ChatModel，模型：{}", zhipuAIConfig.getModel());

        return dev.langchain4j.community.model.zhipu.ZhipuAiChatModel.builder()
                .apiKey(zhipuAIConfig.getApiKey())
                .model(zhipuAIConfig.getModel())
                .temperature(0.7)
                .maxRetries(2)
                .callTimeout(java.time.Duration.ofSeconds(60))
                .connectTimeout(java.time.Duration.ofSeconds(60))
                .writeTimeout(java.time.Duration.ofSeconds(60))
                .readTimeout(java.time.Duration.ofSeconds(60))
                .build();
    }

    /**
     * 配置ChatMemory（对话记忆）
     */
    @Bean
    public ChatMemory workflowChatMemory() {
        log.info("初始化Agentic工作流ChatMemory，消息窗口大小：20");
        return MessageWindowChatMemory.withMaxMessages(20);
    }

    // ==================== L1 基础智能体（只调用工具） ====================

    /**
     * L1 用户偏好Agent（只调用工具，不调用其他Agent）
     * 专门处理用户偏好相关查询
     */
    @Bean
    public UserPreferenceAgent workflowUserPreferenceAgent(ChatModel workflowChatModel) {
        log.info("构建L1: UserPreferenceAgent (Agent层级架构)");

        return AiServices.builder(UserPreferenceAgent.class)
                .chatModel(workflowChatModel)
                .tools(userProfileTools)
                .build();
    }

    /**
     * L1 营养指导Agent
     */
    @Bean
    public NutritionGuideAgent workflowNutritionGuideAgent(ChatModel workflowChatModel) {
        log.info("构建L1: NutritionGuideAgent (Agentic)");

        return AiServices.builder(NutritionGuideAgent.class)
                .chatModel(workflowChatModel)
                .tools(nutritionAnalysisTools, calorieCalculatorTools)
                .build();
    }

    /**
     * L1 菜品推荐Agent
     */
    @Bean
    public DishRecommendationAgent workflowDishRecommendationAgent(ChatModel workflowChatModel) {
        log.info("构建L1: DishRecommendationAgent (Agentic)");

        return AiServices.builder(DishRecommendationAgent.class)
                .chatModel(workflowChatModel)
                .tools(recommendationQueryTools, recommendationFilterTools, recommendationRankTools)
                .build();
    }

    /**
     * L1 商家信息Agent
     */
    @Bean
    public MerchantInfoAgent workflowMerchantInfoAgent(ChatModel workflowChatModel) {
        log.info("构建L1: MerchantInfoAgent (Agentic)");

        return AiServices.builder(MerchantInfoAgent.class)
                .chatModel(workflowChatModel)
                .tools(merchantQueryTools, merchantStatsTools)
                .build();
    }

    /**
     * L1 时间感知Agent
     */
    @Bean
    public TimeAwareAgent workflowTimeAwareAgent(ChatModel workflowChatModel) {
        log.info("构建L1: TimeAwareAgent (Agentic)");

        return AiServices.builder(TimeAwareAgent.class)
                .chatModel(workflowChatModel)
                .tools(timeTools)
                .build();
    }

    /**
     * L1 位置服务Agent
     */
    @Bean
    public LocationServiceAgent workflowLocationServiceAgent(ChatModel workflowChatModel) {
        log.info("构建L1: LocationServiceAgent (Agentic)");

        return AiServices.builder(LocationServiceAgent.class)
                .chatModel(workflowChatModel)
                .tools(locationTools)
                .build();
    }

    /**
     * L1 订单辅助Agent
     */
    @Bean
    public OrderHelperAgent workflowOrderHelperAgent(ChatModel workflowChatModel) {
        log.info("构建L1: OrderHelperAgent (Agentic)");

        return AiServices.builder(OrderHelperAgent.class)
                .chatModel(workflowChatModel)
                .tools(orderQueryTools, orderCreateTools)
                .build();
    }

    // ==================== L2 领域智能体（调用L1 Agent） ====================

    /**
     * L2 智能推荐Agent（调用L1 Agents）
     * 调用 L1: DishRecommendationAgent, LocationServiceAgent, TimeAwareAgent, UserPreferenceAgent
     */
    @Bean
    public SmartRecommendationAgent workflowSmartRecommendationAgent(
            ChatModel workflowChatModel,
            UserPreferenceAgent workflowUserPreferenceAgent,
            DishRecommendationAgent workflowDishRecommendationAgent,
            LocationServiceAgent workflowLocationServiceAgent,
            TimeAwareAgent workflowTimeAwareAgent) {

        log.info("构建L2: SmartRecommendationAgent (调用L1 Agents)");

        // 将L1 Agent作为工具注入，实现Agent调用Agent
        return AiServices.builder(SmartRecommendationAgent.class)
                .chatModel(workflowChatModel)
                .tools(
                    // L1 Agents（作为工具注入）
                    workflowUserPreferenceAgent,
                    workflowDishRecommendationAgent,
                    workflowLocationServiceAgent,
                    workflowTimeAwareAgent,
                    // 也可以直接添加底层工具
                    userProfileTools,
                    recommendationQueryTools,
                    locationTools
                )
                .build();
    }

    /**
     * L2 健康管理Agent（调用L1 Agents）
     * 调用 L1: NutritionGuideAgent, UserPreferenceAgent
     */
    @Bean
    public HealthManagementAgent workflowHealthManagementAgent(
            ChatModel workflowChatModel,
            NutritionGuideAgent workflowNutritionGuideAgent,
            UserPreferenceAgent workflowUserPreferenceAgent) {

        log.info("构建L2: HealthManagementAgent (调用L1 Agents)");

        return AiServices.builder(HealthManagementAgent.class)
                .chatModel(workflowChatModel)
                .tools(
                    // L1 Agents（作为工具注入）
                    workflowNutritionGuideAgent,
                    workflowUserPreferenceAgent,
                    // 也可以直接添加底层工具
                    nutritionAnalysisTools,
                    calorieCalculatorTools
                )
                .build();
    }

    /**
     * L2 全流程订单Agent（调用L1 Agents）
     * 调用 L1: OrderHelperAgent, MerchantInfoAgent, DishRecommendationAgent
     */
    @Bean
    public FullOrderAgent workflowFullOrderAgent(
            ChatModel workflowChatModel,
            OrderHelperAgent workflowOrderHelperAgent,
            MerchantInfoAgent workflowMerchantInfoAgent,
            DishRecommendationAgent workflowDishRecommendationAgent,
            LocationServiceAgent workflowLocationServiceAgent) {

        log.info("构建L2: FullOrderAgent (调用L1 Agents)");

        return AiServices.builder(FullOrderAgent.class)
                .chatModel(workflowChatModel)
                .tools(
                    // L1 Agents（作为工具注入）
                    workflowOrderHelperAgent,
                    workflowMerchantInfoAgent,
                    workflowDishRecommendationAgent,
                    workflowLocationServiceAgent,
                    // 也可以直接添加底层工具
                    orderQueryTools,
                    orderCreateTools
                )
                .build();
    }

    // ==================== L3 编排智能体（调用L2 Agent） ====================

    /**
     * L3 智能助手Agent（调用L2 + L1 Agents）
     * 调用 L2: SmartRecommendationAgent, HealthManagementAgent, FullOrderAgent
     * 也可以直接调用 L1 Agent 进行细粒度控制
     */
    @Bean
    public IntelligentAssistantAgent workflowIntelligentAssistantAgent(
            ChatModel workflowChatModel,
            ChatMemory workflowChatMemory,
            SmartRecommendationAgent workflowSmartRecommendationAgent,
            HealthManagementAgent workflowHealthManagementAgent,
            FullOrderAgent workflowFullOrderAgent,
            // 也可以直接访问L1 Agent
            UserPreferenceAgent workflowUserPreferenceAgent,
            NutritionGuideAgent workflowNutritionGuideAgent,
            DishRecommendationAgent workflowDishRecommendationAgent,
            MerchantInfoAgent workflowMerchantInfoAgent,
            TimeAwareAgent workflowTimeAwareAgent,
            LocationServiceAgent workflowLocationServiceAgent,
            OrderHelperAgent workflowOrderHelperAgent) {

        log.info("构建L3: IntelligentAssistantAgent (调用L2 + L1 Agents)");

        // L3 Agent可以调用所有L2和L1 Agent（作为工具注入）
        return AiServices.builder(IntelligentAssistantAgent.class)
                .chatModel(workflowChatModel)
                .chatMemory(workflowChatMemory)
                .tools(
                    // L2 Agents
                    workflowSmartRecommendationAgent,
                    workflowHealthManagementAgent,
                    workflowFullOrderAgent,
                    // L1 Agents (直接调用进行更细粒度控制)
                    workflowUserPreferenceAgent,
                    workflowNutritionGuideAgent,
                    workflowDishRecommendationAgent,
                    workflowMerchantInfoAgent,
                    workflowTimeAwareAgent,
                    workflowLocationServiceAgent,
                    workflowOrderHelperAgent
                )
                .build();
    }
}
