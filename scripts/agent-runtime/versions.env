# 精确锁定：dsh-superagent / DSH / Node / pnpm。
#
# 改这里必须走升级流程（upgrade.sh：先备份 -> 升级 -> 探针 -> 失败自动回退），
# 不允许"顺手升一下"。占位符（CHANGE_ME_*）会让 upgrade.sh 直接拒绝启动。
#
# 取值来自 dsh-superagent 的 package.json：
#   engines.node = ^22.19.0 || >=24.0.0；engines.dsh = ^0.2.1-alpha.2；
#   packageManager = pnpm@11.7.0。
# dsh-superagent 的提交必须来自你要部署的那个 release，agent 负责人填真实值。
DSH_SUPERAGENT_COMMIT=CHANGE_ME_DSH_SUPERAGENT_COMMIT
DSH_VERSION=0.2.1-rc.3
NODE_MAJOR=22
PNPM_VERSION=11.7.0
