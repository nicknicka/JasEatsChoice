# 精确锁定：dsh-superagent / DSH / Node / pnpm。
#
# 改这里必须走升级流程（upgrade.sh：先备份 -> 升级 -> 探针 -> 失败自动回退），
# 不允许"顺手升一下"。占位符（CHANGE_ME_*）会让 upgrade.sh 直接拒绝启动。
#
# dsh-superagent 提交与 DSH 版本必须来自你要部署的那个 release，agent 负责人填真实值。
DSH_SUPERAGENT_COMMIT=CHANGE_ME_DSH_SUPERAGENT_COMMIT
DSH_VERSION=CHANGE_ME_DSH_VERSION
# Node 主版本与 pnpm 版本是已经在 CI/本机验证过的组合。
NODE_MAJOR=20
PNPM_VERSION=9.12.3
