/**
 * 生产环境配置
 * 用于正式上线
 */

module.exports = {
  // API基础URL - 需要配置为实际的生产服务器地址
  // 注意：小程序要求使用HTTPS协议
  baseURL: 'https://api.yourdomain.com',

  // WebSocket地址
  wsURL: 'wss://api.yourdomain.com/ws',

  // 上传地址
  uploadURL: 'https://api.yourdomain.com/v1/upload',

  // 图片CDN地址（可选）
  imageCDN: 'https://cdn.yourdomain.com',

  // 是否开启调试模式
  debug: false,

  // 请求超时时间（毫秒）
  timeout: 30000,

  // 是否开启请求日志
  enableLog: false,

  // 微信小程序配置
  wechat: {
    appId: 'your_production_appid', // 需要在微信公众平台注册并获取
    // 授权域名需要在微信小程序后台配置
    // 登录：https://mp.weixin.qq.com/
    // 开发 -> 开发管理 -> 开发设置 -> 服务器域名
  }
}
