	"globalStyle": {
		"navigationBarTextStyle": "white",
		"navigationBarTitleText": "佳食宜选",
		"navigationBarBackgroundColor": "#FF6B35",
		"backgroundColor": "#F5F5F5"
	},
	"tabBar": {
		"color": "#999",
		"selectedColor": "#FF6B35",
		"backgroundColor": "#fff",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages-user/home/index",
				"iconPath": "static/home.png",
				"selectedIconPath": "static/home-active.png",
				"text": "首页"
			},
			{
				"pagePath": "pages-user/recipe/today",
				"iconPath": "static/recipe.png",
				"selectedIconPath": "static/recipe-active.png",
				"text": "食谱"
			},
			{
				"pagePath": "pages-user/ai/index",
				"iconPath": "static/ai.png",
				"selectedIconPath": "static/ai-active.png",
				"text": "AI"
			},
			{
				"pagePath": "pages-user/profile/index",
				"iconPath": "static/profile.png",
				"selectedIconPath": "static/profile-active.png",
				"text": "我的"
			}
		]
	},
	"preloadRule": {
		"pages-user/home/index": {
			"network": "all",
			"packages": ["pages-common"]
		}
	}
