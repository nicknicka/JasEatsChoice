<template>
	<view class="favorite-list-card">
		<!-- 卡片头部 -->
		<view class="card-header">
			<view class="header-title">
				<text class="icon">⭐</text>
				<text class="title">收藏列表</text>
			</view>
			<text class="header-summary" v-if="data.summary">{{ data.summary }}</text>
		</view>

		<!-- 卡片内容 -->
		<view class="card-content">
			<!-- 空状态 -->
			<view v-if="!favorites || favorites.length === 0" class="empty-state">
				<text class="empty-icon">💝</text>
				<text class="empty-text">还没有收藏任何内容</text>
			</view>

			<!-- 收藏列表 -->
			<view v-else class="favorite-list">
				<view
					v-for="(item, index) in favorites"
					:key="item.id || item.dishId || index"
					class="favorite-item"
					@tap="handleFavoriteTap(item)"
				>
					<!-- 左侧：图片 -->
					<view class="favorite-image">
						<image
							:src="item.imageUrl || item.image || '/static/images/placeholder-dish.png'"
							mode="aspectFill"
							class="favorite-img"
							@error="handleImageError"
						/>
					</view>

					<!-- 右侧：信息 -->
					<view class="favorite-info">
						<!-- 名称 -->
						<text class="favorite-name">
							{{ item.dishName || item.name || item.title || '未命名' }}
						</text>

						<!-- 描述 -->
						<text
							class="favorite-desc"
							v-if="item.description || item.highlight"
						>
							{{ item.description || item.highlight }}
						</text>

						<!-- 底部信息 -->
						<view class="favorite-meta">
							<text class="price" v-if="item.price">¥{{ item.price }}</text>
							<text class="category" v-if="item.category">{{ item.category }}</text>
							<text class="time">{{ formatTime(item.createTime) }}</text>
						</view>

						<!-- 操作按钮 -->
						<view class="favorite-actions">
							<view
								class="action-btn cancel"
								@tap.stop="handleRemove(item)"
							>
								<text class="action-text">取消收藏</text>
							</view>
						</view>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup>
import { computed } from 'vue';

const props = defineProps({
	data: {
		type: Object,
		default: () => ({})
	}
});

const emit = defineEmits(['action']);

// 收藏列表
const favorites = computed(() => {
	return props.data.favorites || props.data.dishes || [];
});

// 图片加载失败处理
const handleImageError = (e) => {
	e.target.src = '/static/images/placeholder-dish.png';
};

// 格式化时间
const formatTime = (time) => {
	if (!time) return '';
	const date = new Date(time);
	const now = new Date();
	const diff = now - date;

	if (diff < 60000) {
		return '刚刚';
	} else if (diff < 3600000) {
		return Math.floor(diff / 60000) + '分钟前';
	} else if (diff < 86400000) {
		return Math.floor(diff / 3600000) + '小时前';
	} else if (diff < 604800000) {
		return Math.floor(diff / 86400000) + '天前';
	} else {
		return date.toLocaleDateString();
	}
};

// 点击收藏项
const handleFavoriteTap = (item) => {
	console.log('点击收藏项:', item);
	emit('action', {
		type: 'view_detail',
		item: item
	});

	// 跳转到详情页
	uni.navigateTo({
		url: `/pages-user/dish/detail?id=${item.dishId || item.id}`
	});
};

// 取消收藏
const handleRemove = (item) => {
	console.log('取消收藏:', item);
	emit('action', {
		type: 'remove',
		item: item
	});

	uni.showModal({
		title: '确认取消',
		content: '确定要取消收藏吗？',
		success: (res) => {
			if (res.confirm) {
				uni.showToast({
					title: '已取消收藏',
					icon: 'success'
				});
			}
		}
	});
};
</script>

<style lang="scss" scoped>
