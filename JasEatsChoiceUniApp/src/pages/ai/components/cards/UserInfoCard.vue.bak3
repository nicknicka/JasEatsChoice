<template>
	<view class="user-info-card">
		<!-- 卡片头部 -->
		<view class="card-header">
			<view class="header-title">
				<text class="icon">👤</text>
				<text class="title">用户信息</text>
			</view>
		</view>

		<!-- 卡片内容 -->
		<view class="card-content">
			<!-- 空状态 -->
			<view v-if="!data || !data.userId" class="empty-state">
				<text class="empty-icon">🔒</text>
				<text class="empty-text">未授权访问用户信息</text>
			</view>

			<!-- 用户信息 -->
			<view v-else class="user-info">
				<!-- 头部：头像和基本信息 -->
				<view class="user-header">
					<view class="avatar-section">
						<image
							v-if="data.avatar"
								:src="data.avatar"
								mode="aspectFill"
								class="user-avatar"
								@error="handleAvatarError"
							/>
							<text v-else class="placeholder-icon">👤</text>
					</view>
					<view class="basic-info">
						<text class="user-name">{{ data.username || data.nickname || '用户' }}</text>
						<text class="user-id" v-if="data.userId">ID: {{ data.userId }}</text>
					</view>
				</view>

				<!-- 详细信息列表 -->
				<view class="info-list" v-if="hasDetails">
					<view class="info-item" v-if="data.email">
						<text class="info-label">邮箱</text>
						<text class="info-value">{{ data.email }}</text>
					</view>
					<view class="info-item" v-if="data.phone">
						<text class="info-label">手机</text>
						<text class="info-value">{{ data.phone }}</text>
					</view>
					<view class="info-item" v-if="data.studentId">
						<text class="info-label">学号</text>
						<text class="info-value">{{ data.studentId }}</text>
					</view>
					<view class="info-item" v-if="data.school">
						<text class="info-label">学校</text>
						<text class="info-value">{{ data.school }}</text>
					</view>
					<view class="info-item" v-if="data.major">
						<text class="info-label">专业</text>
						<text class="info-value">{{ data.major }}</text>
					</view>
					<view class="info-item" v-if="data.grade">
						<text class="info-label">年级</text>
						<text class="info-value">{{ data.grade }}</text>
					</view>
					<view class="info-item" v-if="data.balance !== undefined">
						<text class="info-label">余额</text>
						<text class="info-value price">¥{{ data.balance }}</text>
					</view>
					<view class="info-item" v-if="data.points !== undefined">
						<text class="info-label">积分</text>
						<text class="info-value">{{ data.points }} 分</text>
					</view>
				</view>

				<!-- 操作按钮 -->
				<view class="user-actions">
					<view class="action-btn primary" @tap="handleViewProfile">
						<text class="action-text">查看完整资料</text>
					</view>
					<view class="action-btn" @tap="handleEditProfile">
						<text class="action-text">编辑资料</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup>
import { computed } from 'vue';

const props = defineProps({
	data: {
		type: Object,
		default: () => ({})
	}
});

const emit = defineEmits(['action']);

// 是否有详细信息
const hasDetails = computed(() => {
	const data = props.data;
	return !!(
		data.email ||
		data.phone ||
		data.studentId ||
		data.school ||
		data.major ||
		data.grade ||
		data.balance !== undefined ||
		data.points !== undefined
	);
});

// 头像加载失败处理
const handleAvatarError = (e) => {
	e.target.src = '/static/images/default-avatar.png';
};

// 查看完整资料
const handleViewProfile = () => {
	console.log('查看完整资料');
	emit('action', {
		type: 'view_profile',
		data: props.data
	});

	// 跳转到个人中心
	uni.navigateTo({
		url: '/pages-user/user-center/index'
	});
};

// 编辑资料
const handleEditProfile = () => {
	console.log('编辑资料');
	emit('action', {
		type: 'edit_profile',
		data: props.data
	});

	// 跳转到编辑页面
	uni.navigateTo({
		url: '/pages/user-center/edit'
	});
};
</script>

<style lang="scss" scoped>
@import "@/styles/variables.scss";

.user-info-card {
	background: $bg-color-white;
	border-radius: $border-radius-lg;
	overflow: hidden;
	box-shadow: $box-shadow-sm;
	margin: $spacing-md 0;
}

.card-header {
	padding: $spacing-lg;
	border-bottom: 1rpx solid $border-color-light;
	background: linear-gradient(135deg, $primary-50, $bg-color-white);
}

.header-title {
	display: flex;
	align-items: center;
	gap: $spacing-sm;
}

.icon {
	font-size: 40rpx;
}

.title {
	font-size: $font-size-lg;
	font-weight: $font-weight-bold;
	color: $text-color-primary;
}

.card-content {
	padding: $spacing-lg;
}

.empty-state {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 80rpx $spacing-lg;
}

.empty-icon {
	font-size: 120rpx;
	margin-bottom: $spacing-lg;
	opacity: 0.5;
}

.empty-text {
	font-size: $font-size-base;
	color: $text-color-secondary;
}

.user-info {
	display: flex;
	flex-direction: column;
	gap: $spacing-lg;
}

.user-header {
	display: flex;
	align-items: center;
	gap: $spacing-md;
	padding-bottom: $spacing-md;
	border-bottom: 1rpx solid $border-color-light;
}

.avatar-section {
	flex-shrink: 0;
}

.user-avatar {
	width: 120rpx;
	height: 120rpx;
	border-radius: 50%;
	background: $bg-color-light;
	border: 4rpx solid $primary-100;
}

.basic-info {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: $spacing-xs;
	min-width: 0;
}

.user-name {
	font-size: $font-size-xl;
	font-weight: $font-weight-bold;
	color: $text-color-primary;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.user-id {
	font-size: $font-size-sm;
	color: $text-color-secondary;
}

.info-list {
	display: flex;
	flex-direction: column;
	gap: $spacing-sm;
}

.info-item {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: $spacing-sm $spacing-md;
	background: $bg-color-base;
	border-radius: $border-radius-base;
}

.info-label {
	font-size: $font-size-sm;
	color: $text-color-secondary;
	font-weight: $font-weight-medium;
}

.info-value {
	font-size: $font-size-base;
	color: $text-color-primary;
	font-weight: $font-weight-medium;
	text-align: right;
	flex: 1;
	margin-left: $spacing-md;

	&.price {
		color: $danger-color;
		font-weight: $font-weight-bold;
	}
}

.user-actions {
	display: flex;
	gap: $spacing-md;
	margin-top: $spacing-md;
}

.action-btn {
	flex: 1;
	padding: $spacing-md;
	border-radius: $border-radius-base;
	text-align: center;
	transition: $transition-base;
	background: $bg-color-base;

	&.primary {
		background: $primary-500;
	}

	&:active {
		opacity: 0.7;
		transform: scale(0.95);
	}
}

.action-text {
	font-size: $font-size-base;
	color: $text-color-primary;
	font-weight: $font-weight-medium;

	.primary & {
		color: $bg-color-white;
	}
}
</style>
