      content: '好的，收到了',
      time: '11:02',
      isRead: true
    },
    {
      id: 3,
      sender: 'user',
      content: '能帮我加一份小菜吗？',
      time: '11:15',
      isRead: false
    }
  ],
  7: [
    {
      id: 1,
      sender: 'user',
      content: '你们今天营业吗？',
      time: '10:50',
      isRead: true
    },
    {
      id: 2,
      sender: 'merchant',
      content: '营业的！我们每天10:00-21:00营业，欢迎点餐',
      time: '10:52',
      isRead: true
    }
  ],
  8: [
    {
      id: 1,
      sender: 'user',
      content: '好评已给，服务很棒！',
      time: '10:30',
      isRead: true
    },
    {
      id: 2,
      sender: 'merchant',
      content: '感谢您的好评！我们会继续努力提供优质服务，期待您的下次光临',
      time: '10:32',
      isRead: true
    }
  ]
})

// 当前对话的聊天记录
const chatMessages = computed(() => {
  if (!selectedConversation.value) return []
  return conversationsMessages.value[selectedConversation.value.id] || []
})

// 排序后的对话列表（有未读消息的在前）
const sortedConversations = computed(() => {
  return [...conversationList.value].sort((a, b) => {
    if (a.unreadCount > 0 && b.unreadCount === 0) return -1
    if (a.unreadCount === 0 && b.unreadCount > 0) return 1
    return 0
  })
})

// 页面加载
onMounted(() => {
  // 默认选中第一个对话
  if (sortedConversations.value.length > 0) {
    selectedConversation.value = sortedConversations.value[0]
  }
})

// 选择对话
const selectConversation = (conversation) => {
  selectedConversation.value = conversation
  // 清空未读消息
  if (conversation.unreadCount > 0) {
    conversation.unreadCount = 0
    ElMessage.success('消息已标记为已读')
  }
}

// 发送消息
const sendMessage = () => {
  if (!newMessage.value.trim() || !selectedConversation.value) {
    return
  }

  // 创建新消息
  const message = {
    id: Date.now(),
    sender: 'merchant',
    content: newMessage.value.trim(),
    time: new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }),
    isRead: true
  }

  // 添加到对应对话的聊天记录
  const conversationId = selectedConversation.value.id
  if (!conversationsMessages.value[conversationId]) {
    conversationsMessages.value[conversationId] = []
  }
  conversationsMessages.value[conversationId].push(message)

  // 更新对话列表的最后一条消息
  selectedConversation.value.lastMessage = message.content
  selectedConversation.value.time = message.time

  // 清空输入框
  newMessage.value = ''
  ElMessage.success('消息发送成功')
}

// 查看订单详情
const viewOrderDetail = () => {
  if (selectedConversation.value?.relatedOrder) {
    showOrderDetail.value = true
  }
}

// 更新订单状态
const updateOrderStatus = (newStatus) => {
  if (selectedConversation.value?.relatedOrder) {
    ElMessageBox.confirm(
      `确定要将订单状态更新为"${orderStatusMap[newStatus].text}"吗？`,
      '更新订单状态',
      {
        confirmButtonText: '确定',
        cancelButtonText: '取消',
        type: 'warning'
      }
    ).then(() => {
      selectedConversation.value.relatedOrder.status = newStatus
      ElMessage.success('订单状态已更新')

      // 发送系统消息通知用户
      const statusMsg = {
        id: Date.now(),
        sender: 'merchant',
        content: `您的订单状态已更新为：${orderStatusMap[newStatus].text}`,
        time: new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }),
        isRead: true
      }

      const conversationId = selectedConversation.value.id
      if (!conversationsMessages.value[conversationId]) {
        conversationsMessages.value[conversationId] = []
      }
      conversationsMessages.value[conversationId].push(statusMsg)
    }).catch(() => {})
  }
}

// 发送订单提醒
const sendOrderReminder = () => {
  if (selectedConversation.value?.relatedOrder) {
    const reminderMsg = {
      id: Date.now(),
      sender: 'merchant',
      content: `您的订单（${selectedConversation.value.relatedOrder.orderId}）${orderStatusMap[selectedConversation.value.relatedOrder.status].text}，请耐心等待`,
      time: new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }),
      isRead: true
    }

    const conversationId = selectedConversation.value.id
    if (!conversationsMessages.value[conversationId]) {
      conversationsMessages.value[conversationId] = []
    }
    conversationsMessages.value[conversationId].push(reminderMsg)

    ElMessage.success('订单提醒已发送')
  }
}
</script>

<template>
  <div class="private-chat-container">
    <!-- 头部 -->
    <div class="chat-header">
      <div class="header-left">
        <h3 class="page-title">单聊会话</h3>
        <p class="page-subtitle" v-if="selectedConversation">
          客户：{{ selectedConversation.userName }}
        </p>
      </div>
      <div class="header-right">
        <CommonBackButton />
      </div>
    </div>

    <div class="chat-content">
      <!-- 对话列表 -->
      <div class="conversation-list">
        <div class="list-header">
          <div class="header-title">
            <el-icon :size="18"><ChatDotRound /></el-icon>
            <span>会话列表</span>
          </div>
        </div>
        <div
          v-for="conversation in sortedConversations"
          :key="conversation.id"
          class="conversation-item"
          :class="{
            active: selectedConversation?.id === conversation.id,
            'has-unread': conversation.unreadCount > 0,
            'has-order': conversation.relatedOrder
          }"
          @click="selectConversation(conversation)"
        >
          <div class="conversation-avatar">
            <div class="emoji-avatar">{{ conversation.userAvatar }}</div>
            <div v-if="conversation.unreadCount > 0" class="unread-badge">
              {{ conversation.unreadCount }}
            </div>
            <div v-if="conversation.relatedOrder" class="order-indicator" title="有关联订单">
              📋
            </div>
          </div>
          <div class="conversation-info">
            <div class="user-name-time">
              <span class="user-name">{{ conversation.userName }}</span>
              <span class="time">{{ conversation.time }}</span>
            </div>
            <div class="last-message">{{ conversation.lastMessage }}</div>
          </div>
        </div>
      </div>

      <!-- 聊天区域 -->
      <div class="chat-area" v-if="selectedConversation">
        <!-- 用户信息头 -->
        <div class="user-header">
          <div class="user-info">
            <div class="user-avatar-large">{{ selectedConversation.userAvatar }}</div>
            <div class="user-details">
              <div class="user-name">{{ selectedConversation.userName }}</div>
              <div class="user-status" v-if="selectedConversation.relatedOrder">
                <el-tag :type="orderStatusMap[selectedConversation.relatedOrder.status]?.type" size="small">
                  {{ orderStatusMap[selectedConversation.relatedOrder.status]?.text }}
                </el-tag>
              </div>
            </div>
          </div>
        </div>

        <!-- 关联订单信息 -->
        <div class="order-info-section" v-if="selectedConversation.relatedOrder && !showOrderDetail">
          <div class="order-info-header">
            <div class="header-title">
              <el-icon :size="18"><ShoppingBag /></el-icon>
              <span>关联订单信息</span>
            </div>
            <el-button type="primary" size="small" @click="showOrderDetail = true" :icon="View">
              查看详情
            </el-button>
          </div>
          <div class="order-info-summary">
            <div class="info-item">
              <span class="label">订单号：</span>
              <span class="value">{{ selectedConversation.relatedOrder.orderId }}</span>
            </div>
            <div class="info-item">
              <span class="label">金额：</span>
              <span class="value amount">¥{{ selectedConversation.relatedOrder.totalAmount }}</span>
            </div>
            <div class="info-item">
              <span class="label">状态：</span>
              <el-tag :type="orderStatusMap[selectedConversation.relatedOrder.status]?.type" size="small">
                {{ orderStatusMap[selectedConversation.relatedOrder.status]?.text }}
              </el-tag>
            </div>
          </div>
        </div>

        <!-- 订单详情面板 -->
        <div class="order-detail-panel" v-if="selectedConversation.relatedOrder && showOrderDetail">
          <div class="detail-header">
            <div class="header-title">
              <el-icon :size="18"><Document /></el-icon>
              <span>订单详情</span>
            </div>
            <el-button size="small" @click="showOrderDetail = false">收起</el-button>
          </div>

          <div class="detail-content">
            <div class="order-basic-info">
              <div class="info-row">
                <span class="label">订单号</span>
                <span class="value">{{ selectedConversation.relatedOrder.orderId }}</span>
              </div>
              <div class="info-row">
                <span class="label">联系电话</span>
                <span class="value">{{ selectedConversation.relatedOrder.phone }}</span>
              </div>
              <div class="info-row">
                <span class="label">配送地址</span>
                <span class="value">{{ selectedConversation.relatedOrder.address }}</span>
              </div>
            </div>

            <div class="order-items">
              <div class="items-title">菜品清单</div>
              <div v-for="(item, index) in selectedConversation.relatedOrder.items" :key="index" class="item-row">
                <span class="item-name">{{ item.name }}</span>
                <span class="item-quantity">×{{ item.quantity }}</span>
                <span class="item-price">¥{{ item.price }}</span>
              </div>
            </div>

            <div class="order-total">
              <div class="total-row">
                <span class="label">订单总额</span>
                <span class="value amount">¥{{ selectedConversation.relatedOrder.totalAmount }}</span>
              </div>
            </div>
          </div>

          <div class="detail-actions">
            <div class="actions-title">快捷操作</div>
            <div class="action-buttons">
              <el-button size="small" @click="router.push(`/merchant/home/order-detail/${selectedConversation.relatedOrder.orderId}`)" :icon="View">
                查看订单
              </el-button>
              <el-dropdown trigger="click">
                <el-button type="primary" size="small" :icon="Refresh">
                  更新状态
                </el-button>
                <template #dropdown>
                  <el-dropdown-menu>
                    <el-dropdown-item
                      v-for="(status, key) in orderStatusMap"
                      :key="key"
                      @click="updateOrderStatus(parseInt(key))"
                      :disabled="parseInt(key) === selectedConversation.relatedOrder.status"
                    >
                      <el-tag :type="status.type" size="small">{{ status.text }}</el-tag>
                    </el-dropdown-item>
                  </el-dropdown-menu>
                </template>
              </el-dropdown>
              <el-button type="success" size="small" @click="sendOrderReminder" :icon="Timer">
                发送提醒
              </el-button>
            </div>
          </div>
        </div>

        <!-- 聊天消息 -->
        <div class="messages-container">
          <div
            v-for="message in chatMessages"
            :key="message.id"
            class="message-item"
            :class="{
              'user-message': message.sender === 'user',
              'merchant-message': message.sender === 'merchant'
            }"
          >
            <div class="message-content">
              <div class="message-text">{{ message.content }}</div>
              <div class="message-time">{{ message.time }}</div>
            </div>
          </div>
        </div>

        <!-- 消息输入 -->
        <div class="message-input-container">
          <el-input
            v-model="newMessage"
            type="textarea"
            placeholder="输入消息内容..."
            :rows="2"
            @keyup.enter.ctrl="sendMessage"
          />
          <el-button type="primary" @click="sendMessage" :icon="ChatDotRound">
            发送
          </el-button>
        </div>

        <!-- 安全提示 -->
        <div class="security-tip">
          <el-icon :size="14"><ChatDotRound /></el-icon>
          <span>此会话仅与该客户沟通，消息已加密处理</span>
        </div>
      </div>
    </div>
  </div>
</template>

<style scoped lang="less">
.private-chat-container {
  padding: 0 20px 20px 20px;
  height: calc(100vh - 60px);

  .chat-header {
    margin-bottom: 20px;
    .page-title {
      font-size: 20px;
      font-weight: 700;
      margin: 0;
      color: #1f2937;
    }
  }

  .chat-content {
    display: flex;
    gap: 20px;
    height: calc(100vh - 120px);

    .conversation-list {
      width: 320px;
      border: 1px solid #e8eef5;
      border-radius: 16px;
      overflow-y: auto;
      background: #ffffff;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);

      .list-header {
        padding: 18px 20px;
        border-bottom: 1px solid #e8eef5;
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);

        .header-title {
          display: flex;
          align-items: center;
          gap: 8px;
          font-size: 15px;
          font-weight: 600;
          color: #1f2937;
        }
      }

      .conversation-item {
        display: flex;
        align-items: center;
        padding: 14px 16px;
        cursor: pointer;
