      items: [
        { name: '糖醋里脊', quantity: 1, price: 38 },
        { name: '酸辣汤', quantity: 2, price: 15 }
      ],
      status: 5,
      totalAmount: 68,
      address: '北京市丰台区科技园',
      phone: '133****4444'
    }
  }
])

// 当前选中的对话
const selectedConversation = ref(null)

// 新消息内容
const newMessage = ref('')

// 显示关联订单详情
const showOrderDetail = ref(false)

// 为每个对话存储聊天记录
const conversationsMessages = ref({
  1: [
    {
      id: 1,
      sender: 'user',
      content: '你好，我刚才下单了，订单号是 JD20241121001',
      time: '12:15',
      isRead: true
    },
    {
      id: 2,
      sender: 'merchant',
      content: '您好！您的订单我们已经收到了，正在准备中',
      time: '12:18',
      isRead: true
    },
    {
      id: 3,
      sender: 'user',
      content: '我的订单什么时候能好？大概需要等多久？',
      time: '12:30',
      isRead: false
    },
    {
      id: 4,
      sender: 'merchant',
      content: '正在制作中，您的麻辣香锅饭和鱼香肉丝面都在烹饪中，预计10分钟后可以完成',
      time: '12:35',
      isRead: true
    },
    {
      id: 5,
      sender: 'user',
      content: '太好了，我不吃辣，麻辣香锅能少放点辣椒吗？',
      time: '12:38',
      isRead: true
    },
    {
      id: 6,
      sender: 'merchant',
      content: '没问题，我们已经在备注里标注了微辣，您放心！',
      time: '12:40',
      isRead: true
    },
    {
      id: 7,
      sender: 'user',
      content: '好的，谢谢！',
      time: '12:42',
      isRead: true
    },
    {
      id: 8,
      sender: 'user',
      content: '请问配送需要多长时间？我在望京SOHO这边',
      time: '12:45',
      isRead: false
    }
  ],
  2: [
    {
      id: 1,
      sender: 'user',
      content: '你好，请问你们店里有什么推荐菜品吗？',
      time: '11:50',
      isRead: true
    },
    {
      id: 2,
      sender: 'merchant',
      content: '您好！我们的招牌菜有红烧肉套餐、宫保鸡丁和水煮鱼，都很受欢迎哦',
      time: '11:52',
      isRead: true
    },
    {
      id: 3,
      sender: 'user',
      content: '好的，谢谢！',
      time: '12:25',
      isRead: true
    }
  ],
  3: [
    {
      id: 1,
      sender: 'user',
      content: '什么时候能配送？',
      time: '12:20',
      isRead: true
    }
  ],
  4: [
    {
      id: 1,
      sender: 'user',
      content: '你好，请问有素食套餐吗？',
      time: '11:30',
      isRead: true
    },
    {
      id: 2,
      sender: 'merchant',
      content: '您好！我们有清炒时蔬、麻婆豆腐等素食菜品',
      time: '11:32',
      isRead: true
    },
    {
      id: 3,
      sender: 'user',
      content: '太好了，我点一份清炒时蔬和宫保鸡丁',
      time: '11:35',
      isRead: false
    },
    {
      id: 4,
      sender: 'merchant',
      content: '好的，您的订单已收到，正在准备中',
      time: '11:38',
      isRead: false
    },
    {
      id: 5,
      sender: 'user',
      content: '请问有素食套餐吗？我想看看还有什么选择',
      time: '11:45',
      isRead: false
    }
  ],
  5: [
    {
      id: 1,
      sender: 'user',
      content: '订单已经收到了，谢谢！',
      time: '11:30',
      isRead: true
    },
    {
      id: 2,
      sender: 'merchant',
      content: '不客气！希望您用餐愉快，有问题随时联系我们',
      time: '11:32',
      isRead: true
    }
  ],
  6: [
    {
      id: 1,
      sender: 'user',
      content: '你好，我点了一份水煮鱼',
      time: '11:00',
      isRead: true
    },
    {
      id: 2,
