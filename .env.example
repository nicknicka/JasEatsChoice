# 环境变量配置文件
# 复制此文件为 .env 并修改相应值

# ==================== 数据库配置 ====================
MYSQL_ROOT_PASSWORD=your_secure_mysql_password

# ==================== 服务配置 ====================
# 你的服务器公网地址或域名
SERVER_URL=http://your-server-ip:7777/api

# ==================== 安全配置 ====================
# JWT密钥（使用强随机字符串）
JWT_SECRET=change_this_to_a_very_long_random_string_at_least_32_chars

# ==================== 第三方服务 ====================
# 智谱AI API密钥
ZHIPU_API_KEY=your_zhipu_api_key

# 高德地图 API Key
AMAP_API_KEY=your_amap_api_key

# ==================== 邮件配置 ====================
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USERNAME=your_email@qq.com
EMAIL_PASSWORD=your_email_auth_code
