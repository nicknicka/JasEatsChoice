# 支付配置位（当前均未启用）
#
# 微信支付、支付宝支付当前没有支付权限，也不接入第三方支付 SDK。
# 本文件只保留配置骨架，应用能力统一返回“暂未开放”。
# 所有值必须通过环境变量注入；不要在这里写真实密钥、证书或商户号。

payment:
  wechat:
    app-id: ${WECHAT_PAY_APP_ID:}
    mch-id: ${WECHAT_PAY_MCH_ID:}
    api-key: ${WECHAT_PAY_API_KEY:}
    cert-serial-no: ${WECHAT_PAY_CERT_SERIAL_NO:}
    cert-path: ${WECHAT_PAY_CERT_PATH:}
    key-path: ${WECHAT_PAY_KEY_PATH:}
    notify-url: ${WECHAT_PAY_NOTIFY_URL:}
    sandbox: ${WECHAT_PAY_SANDBOX:false}

  alipay:
    app-id: ${ALIPAY_APP_ID:}
    app-private-key: ${ALIPAY_APP_PRIVATE_KEY:}
    alipay-public-key: ${ALIPAY_PUBLIC_KEY:}
    notify-url: ${ALIPAY_NOTIFY_URL:}
    sandbox: ${ALIPAY_SANDBOX:false}
    sign-type: ${ALIPAY_SIGN_TYPE:RSA2}
    charset: UTF-8
    format: json
