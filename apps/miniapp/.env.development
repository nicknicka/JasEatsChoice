# 小程序开发环境（uni-app 读取 .env.[mode]，变量必须以 VITE_ 开头才会打进包）
# 本机联调：后端直跑 7777，Netty WebSocket 独立端口 11277
VITE_API_BASE_URL=http://localhost:7777/api
VITE_WS_URL=ws://localhost:11277/ws
VITE_UPLOAD_URL=http://localhost:7777/api/v1/upload
VITE_IMAGE_CDN=

# 商家分享链接指向的 Web 站点：本机 Web 版（apps/client 下 npm run dev:web）
VITE_SHARE_BASE_URL=http://localhost:5173

# 微信小程序 AppID：填自己的，不要提交真实值以外的敏感信息（AppID 本身可公开）
VITE_WECHAT_APPID=
