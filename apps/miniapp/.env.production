# 小程序生产环境：必须是 HTTPS/WSS 公网域名，
# 且与微信公众平台「服务器域名」里登记的 request / uploadFile / socket 合法域名一致
VITE_API_BASE_URL=https://api.example.com/api
VITE_WS_URL=wss://api.example.com/ws
VITE_UPLOAD_URL=https://api.example.com/api/v1/upload
VITE_IMAGE_CDN=

# 商家分享链接指向的 Web 站点：Web 版部署域名
VITE_SHARE_BASE_URL=https://api.example.com

VITE_WECHAT_APPID=
