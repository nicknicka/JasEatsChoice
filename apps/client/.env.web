# Web 版构建专用（vite build --config vite.web.config.js --mode web）
#
# 这里全部留空是有意为之：config/index.js 在浏览器环境下会把空值退化成
# 同源相对路径（/api、wss://<当前域名>/ws），所以静态产物不绑定任何后端域名，
# 由部署方的 nginx 反代决定后端在哪。
#
# 优先级说明：.env.web 会覆盖 .env.local 与 .env.production，
# 避免本地 Electron 开发用的绝对地址被打进 Web 产物。
# 只有确实要让 Web 版指向某个固定后端时，才在下面填绝对地址。
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_WS_CHAT_URL=
VITE_UPLOAD_URL=
VITE_IMAGE_CDN=

# 高德地图 JS API 需前端明文 key，属于部署方自己的配置，仓库不保留明文
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JS_CODE=
