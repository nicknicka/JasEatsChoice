# Electron 打包专用（electron-vite build，mode=production）
#
# 地址全部留空 = 让 config/index.js 回落到 http://localhost:7777 与 ws://localhost:11277，
# 因为桌面端产物是 file: 协议，没有"同源"可用，本地起后端就能跑。
# 要把桌面客户端指向某个公网后端时，再在这里填绝对地址（Web 版另有 .env.web，不读这个文件）。
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_WS_CHAT_URL=
VITE_UPLOAD_URL=
VITE_IMAGE_CDN=

# 高德地图 JS API 的 key 必须随前端产物下发，属部署方配置，仓库不保留明文
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JS_CODE=
