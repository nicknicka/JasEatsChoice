# HTTP -> HTTPS redirect + ACME challenge
server {
    listen 80;
    server_name ${API_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate ${SSL_CERT_DIR}/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key ${SSL_CERT_DIR}/live/${API_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    add_header Strict-Transport-Security "max-age=15768000; includeSubDomains; preload" always;
    include /etc/nginx/snippets/security-headers.conf;

    access_log /var/log/nginx/prod-access.log main;
    error_log /var/log/nginx/prod-error.log warn;

    include /etc/nginx/snippets/proxy-defaults.conf;

    # --- Web 版前端：Vite 构建产物（apps/client/dist-web 挂载到 /usr/share/nginx/html） ---
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # --- 登录/注册/验证码：更严格限流 ---
    location ~ ^/api/(v1/users/login|v1/users/register|v1/users/send-sms-code|v1/captcha|admin/login) {
        include /etc/nginx/snippets/proxy-params.conf;
        limit_req zone=login_limit burst=10 nodelay;
        proxy_pass http://spring_boot;
    }

    # SSE 必须在通用 /api/ 之前
    location /api/agent/supervisor-sse/ {
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_pass http://spring_boot;

        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_set_header Upgrade $http_upgrade;
        chunked_transfer_encoding on;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 10m;
    }

    # AI 食谱优化 SSE：后端 SseEmitter 超时 300s，实测长食谱需要 ~110s，
    # 落在通用 /api/ 会被 server 级 proxy_read_timeout 60s 掐断，且默认缓冲会让进度事件失去实时性。
    location /api/v1/ai/recipe/stream {
        include /etc/nginx/snippets/proxy-params.conf;
        limit_req zone=api_limit burst=60 nodelay;
        proxy_pass http://spring_boot;

        proxy_buffering off;
        proxy_cache off;
        gzip off;
        chunked_transfer_encoding on;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # AI 菜品识别：http 级是 220m，但视觉识别不需要这么大。前端上限 10MB，
    # 超大图会被整块读进内存做 Base64（体积再涨 4/3）并推高 token 成本，这里收紧到 12m。
    # 同时把 read timeout 抬到 180s：后端 AI 超时是 150s，通用 /api/ 的 60s 会先掐断。
    location /api/v1/ai/dish-recognize {
        include /etc/nginx/snippets/proxy-params.conf;
        limit_req zone=api_limit burst=60 nodelay;
        client_max_body_size 12m;
        proxy_read_timeout 180s;
        proxy_pass http://spring_boot;
    }

    # 上传文件由 Nginx 直接服务
    location /api/uploads/ {
        alias /data/uploads/;
        expires 7d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;

        location ~* \.(php|jsp|py|sh|cgi)$ {
            deny all;
        }

        sendfile on;
        tcp_nopush on;
    }

    location /api/files/ {
        alias /data/uploads/;
        expires 7d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;

        location ~* \.(php|jsp|py|sh|cgi)$ {
            deny all;
        }

        sendfile on;
        tcp_nopush on;
    }

    location ~ ^/api/v1/(upload|chat/upload-image|chat/upload-file|users/[^/]+/avatar) {
        include /etc/nginx/snippets/proxy-params.conf;
        limit_req zone=upload_limit burst=20 nodelay;
        client_max_body_size 220m;
        proxy_pass http://spring_boot;
    }

    location /api/actuator/ {
        include /etc/nginx/snippets/proxy-params.conf;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        allow 127.0.0.1;
        deny all;
        proxy_pass http://spring_boot;
    }

    location /api/ {
        include /etc/nginx/snippets/proxy-params.conf;
        limit_req zone=api_limit burst=60 nodelay;
        proxy_pass http://spring_boot;
    }

    location /ws/chat {
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_pass http://netty_ws;
        proxy_set_header Upgrade $http_upgrade;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /ws/ {
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_pass http://netty_ws;
        proxy_set_header Upgrade $http_upgrade;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /nginx-health {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }
}
