# Copy to deploy/.env (never committed) or run `make env` / `scripts/gen-env.sh`.
# compose reads this file automatically because it sits next to the compose files.

# ---- MySQL ----
# MYSQL_ROOT_PASSWORD is admin-only (health checks, dumps, `make reset-db`).
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=jia_shi_yi_xuan
# The app logs in with this account. The MySQL image creates it on first init and
# grants it MYSQL_DATABASE only, so it must NOT be root (the image rejects that).
DB_USERNAME=jaseats
DB_PASSWORD=change_me_app

# ---- Redis ----
REDIS_PASSWORD=change_me_redis

# ---- Auth ----
# >= 32 random chars; use a fresh value per environment
JWT_SECRET=change_me_to_a_32_plus_char_random_string
JWT_EXPIRATION=86400000

# ---- AI (通用配置) ----
# provider: zhipu（默认）/ qwen / doubao / ollama / ...
# 具体供应商的专属 key 仍用各段的变量（如 ZHIPU_API_KEY），
# AI_API_KEY 是通用兜底，供应商自己的 key 优先级更高。
AI_PROVIDER=zhipu
AI_API_KEY=
AI_MODEL=glm-4-flash
AI_SUPERVISOR_MODEL=glm-4-flash
AI_VISION_MODEL=glm-4.1v-thinking-flash
AI_BASE_URL=
AI_TIMEOUT=30000
AI_TEMPERATURE=0.7

# ---- AI (Zhipu 专属，可选，优先级高于 AI_*) ----
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# ---- Announcement RAG（真实密钥仍只用 ZHIPU_API_KEY） ----
ANNOUNCEMENT_RAG_ENABLED=true
QDRANT_COLLECTION=jaseats_announcements
ZHIPU_EMBEDDING_MODEL=embedding-3
AI_EMBEDDING_DIMENSIONS=2048
ZHIPU_EMBEDDING_BASE_URL=

# ---- Map APIs ----
# 后端侧（REST 服务端 key，不会被下发到浏览器）：
#   高德 Web 服务 key（行政区域/天气/地理编码）→ https://console.amap.com/dev/key/app
#   腾讯位置服务 key（IP 定位）                 → https://lbs.qq.com/dev/console/application/mine
AMAP_API_KEY=
TENCENT_MAP_KEY=
# 前端侧的 JS API key / 安全密钥不下发到容器，放在 apps/client/.env.web.local
#（mode=web）与 apps/client/src/renderer/.env.local（Electron dev），两者均 gitignore。
# 生产静态产物若要用地图，构建时把 VITE_AMAP_KEY / VITE_AMAP_SECURITY_JS_CODE
# 注入构建 shell 环境变量即可（见 scripts/package_delivery_bundle.sh 的替换提示）。

# ---- Outbound email (QQ SMTP authorization code) ----
# MAIL_USERNAME 是发件邮箱全名（如 1640343748@qq.com），
# MAIL_PASSWORD 是邮箱「设置→账户→POP3/SMTP」生成的授权码，不是登录密码。
# 两者任一为空时 EmailService 不发信，相关功能静默降级。
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Captcha ----
# true makes /captcha return the fixed code straight to the client.
# Local automation only; must stay false in prod.
CAPTCHA_TEST_FIXED_CODE_ENABLED=false
CAPTCHA_TEST_FIXED_CODE=

# ---- Uploads / routing ----
FILE_UPLOAD_PATH=/data/uploads/
FILE_SERVER_URL=http://localhost/api

# ---- Spring ----
SPRING_PROFILES_ACTIVE=local
WORKER_ID=1
DATACENTER_ID=1
# Server/Netty ports and the in-container upload path are pinned inside
# compose.yml (the containers talk to each other by fixed ports), so they are
# deliberately not listed here as tunable knobs.

# ---- Prod overlay only ----
API_DOMAIN=api.example.com
WEB_ROOT=/var/www/jaseats
# Directory holding <API_DOMAIN>.fullchain.pem / <API_DOMAIN>.privkey.pem
SSL_CERT_DIR=/etc/letsencrypt/live

# ---- Playwright ----
# Read by tests/fixtures/test-base.js and tests/playwright.config.js from the
# shell environment, NOT injected by compose. The defaults below match the local
# dev stack, so `make test` needs none of them; CI overrides them per runner.
TEST_API_BASE=http://localhost:7777/api
PLAYWRIGHT_BASE_URL=http://localhost:5173
TEST_USER_PHONE=17322222222
TEST_USER_PWD=asdasd
TEST_MERCHANT_PHONE=17322222222
TEST_MERCHANT_PWD=asdasd
TEST_ADMIN_USER=admin
TEST_ADMIN_PWD=admin123
